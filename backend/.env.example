# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Core -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/razorpay_recovery

# --- Gemini agent layer (optional) ---------------------------------
# When unset, the Gemini agent path degrades gracefully; rules/ml/uplift
# policies are unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TURNS=4
GEMINI_TIMEOUT_SECONDS=20

# --- Razorpay integration (TEST MODE ONLY this stage) --------------
# Get a test key pair from the Razorpay Dashboard (Test Mode). The key id
# MUST start with "rzp_test_"; the live execution path refuses anything else.
# The webhook secret is the value you set when creating the webhook in the
# Dashboard -- it is used to verify X-Razorpay-Signature.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TEST_MODE=true
RAZORPAY_TIMEOUT_SECONDS=15
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=60

# --- Hinglish voice / text-to-speech (DEMO SCOPE) ------------------
# Converts the agent's Hinglish customer_message into a real audio FILE,
# retrievable at GET /api/v1/voice/{audio_id}. It is NOT a phone call and
# reaches no customer through any channel. Off by default; failures fall back
# to text-only and never crash the recovery flow.
# NOTE: with the local pyttsx3 engine, audio is spoken by the installed OS
# voices only (en-US here) -- a real TTS file, not native Hindi pronunciation.
TTS_ENABLED=false
TTS_LANGUAGE=hi
TTS_OUTPUT_DIR=artifacts/tts
TTS_ENGINE=pyttsx3
